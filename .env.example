# --- Server ---
PORT=4000

# --- Database ---
# SQLite is used for local development. Prisma's datasource provider is
# fixed to sqlite (see prisma/schema.prisma); a production deployment on a
# different database engine would require changing the provider there too,
# not just this URL.
DATABASE_URL="file:./dev.db"

# --- Auth ---
# Generate a long random value for real environments; never reuse this one.
JWT_SECRET="super-secret-jwt-key-change-this-in-production"

# --- Email (Nodemailer/SMTP) — used to send registration OTP codes ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-username@example.com
SMTP_PASS=your-smtp-app-password
FROM_EMAIL="AI Receptionist <no-reply@example.com>"

# --- AI (Groq) — used by aiCallService for prompt generation & call analysis ---
GROQ_API_KEY=your-groq-api-key

# --- Telephony (Twilio) — inbound call webhook (Phase 4A) and real phone
# number provisioning (Phase 5.1). Found in the Twilio Console.
# TWILIO_AUTH_TOKEN verifies the X-Twilio-Signature header on every webhook
# request. Both values are also used server-side to search/purchase/release
# phone numbers via the REST API. Never expose either to the mobile app or
# log them.
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# The exact public HTTPS origin Twilio will call (no trailing slash), e.g.
# your ngrok URL in development or your real domain in production. Must
# match, byte-for-byte, the URL configured in the Twilio console for
# signature verification to succeed.
PUBLIC_BASE_URL=https://your-public-url.example.com

# How many minutes an in-memory call conversation may sit idle before the
# maintenance sweep considers it abandoned and removes it. Optional —
# defaults to 30 if unset. See callSessionService.ts.
CALL_SESSION_TIMEOUT_MINUTES=30

# --- LiveKit Cloud — in-app WebRTC audio transport for Mwakire's customer
# app calls (src/calls/, src/voice/). NOT the same thing as Twilio, which
# remains solely for the legacy inbound-phone-call path.
# Sign up at https://cloud.livekit.io, create a project, and copy these
# from Settings -> Keys. Until all three are set, POST /api/app-calls/:id/
# connect returns 503 ("voice calling is not available yet") rather than
# failing unsafely.
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Google Cloud Text-to-Speech — PRIMARY AI receptionist voice provider
# for in-app calls (src/voice/text-to-speech.ts). This is Google Cloud's
# actual TTS product, distinct from the Gemini API below — chosen for its
# much larger "always free" quota (~4M characters/month for Standard
# voices) after Gemini's free tier proved too limited for real calls.
# Setup: console.cloud.google.com -> create a project -> link a billing
# account (required even to stay within the free tier) -> enable the
# "Cloud Text-to-Speech API" -> APIs & Services > Credentials > Create API
# key. Until this is set, TTS falls through to the Gemini fallback below.
GOOGLE_TTS_API_KEY=your-google-cloud-api-key
# Both optional — a Standard voice by default (in the largest free tier).
# Browse alternatives at https://cloud.google.com/text-to-speech/docs/voices.
GOOGLE_TTS_VOICE_NAME=en-US-Standard-C
GOOGLE_TTS_LANGUAGE_CODE=en-US

# --- Gemini API — FALLBACK voice provider, used automatically only when
# Google Cloud TTS above fails (e.g. not configured, or its own quota is
# hit). Genuinely free within rate limits, no credit card required. Get a
# key at https://aistudio.google.com (Get API key). If NEITHER this nor
# GOOGLE_TTS_API_KEY is set, the AI can transcribe and generate a reply but
# has nothing to speak it with.
GEMINI_API_KEY=your-gemini-api-key
# Both optional. This is a PREVIEW model — Google may rename/replace it;
# check https://ai.google.dev/gemini-api/docs/speech-generation if this
# starts failing, and override here rather than editing code.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
