{
  "name": "ai-receptionist-backend",
  "version": "1.0.0",
  "description": "Backend API for AI Voice Receptionist Owner Mobile App",
  "main": "dist/index.js",
  "scripts": {
    "build": "node init && tsc",
    "start": "node init && node dist/index.js",
    "dev": "node init && ts-node-dev --respawn --transpile-only src/index.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "test": "jest"
  },
  "dependencies": {
    "@livekit/rtc-node": "^1.0.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.19.0",
    "nodemailer": "^9.0.5",
    "twilio": "^6.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.1",
    "jest": "^30.5.1",
    "prisma": "^5.22.0",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
